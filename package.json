{
  "name": "standing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "invite": "node --env-file=.env.local scripts/invite.mjs",
    "db:push": "set -a && . ./.env.local && set +a && npx -y supabase@2 db push --db-url \"$SUPABASE_DB_URL\" --include-seed",
    "db:types": "set -a && . ./.env.local && set +a && npx -y supabase@2 gen types typescript --db-url \"$SUPABASE_DB_URL\" --schema public > src/types/database.ts",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "postinstall": "node scripts/copy-opencv.mjs"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.69.0",
    "@google/genai": "^2.24.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
