# Copy to .env.local and fill in. Never commit .env.local.

# The site's public address. On Vercel, set it to your production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API Keys (URL under Data API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security; never expose it to the browser.
SUPABASE_SECRET_KEY=
# For applying migrations (npm run db:push): Connect → Session pooler connection string
SUPABASE_DB_URL=

# Gemini (reads the summons): aistudio.google.com → Get API key
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=

# ElevenLabs (read aloud): elevenlabs.io → Developers → API keys
ELEVENLABS_API_KEY=
# Optional voice ID; defaults to "Sarah" (EXAVITQu4vr4xnSDxMaL)
ELEVENLABS_VOICE_ID=

# ArcGIS (address geocoding): developers.arcgis.com → API key with Geocoding
ARCGIS_API_KEY=

# End-to-end tests (npm run test:e2e): an advocate account to sign in with (npm run seed:demo creates one)
E2E_ADVOCATE_EMAIL=
E2E_ADVOCATE_PASSWORD=
